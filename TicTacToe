  </div>

  <div class="content">
    <section class="layout">
      <aside class="card sidebar">
        <div>
          <h3>Legend</h3>
          <div class="legend">
            <div class="legend-row"><span class="symbol initial"></span><span>Initial node</span></div>
            <div class="legend-row"><span class="symbol action"></span><span>Action</span></div>
            <div class="legend-row"><span class="symbol decision"></span><span>Decision or merge</span></div>
