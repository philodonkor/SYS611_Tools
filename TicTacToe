<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SYS 611 Activity Diagram Lab</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

  :root{
    --navy:#0A0A0D;
    --navy-soft:#14161B;
    --navy-soft2:#1B1E25;
    --cyan:#2BB4E0;
    --cyan-soft:#B9E7F5;
    --cyan-faint:#E7F6FC;
    --paper:#F7F8FA;
    --card:#FFFFFF;
    --line:#E2E5EA;
    --ink:#14171C;
    --ink-muted:#5B6472;
    --danger:#D64545;
    --danger-bg:#FBEAEA;
    --success:#1F9D55;
    --success-bg:#E7F7ED;
  }
*{box-sizing:border-box}
body{
    margin:0;
    font-family:'Inter',-apple-system,Helvetica,Arial,sans-serif;
    background:var(--navy);
    color:var(--ink);
  }
button,input{font:inherit}
button{cursor:pointer}
h1,h2,h3,p{margin:0}
.scr-dg .app{ max-width:1440px; margin:0 auto; padding:0 0 32px; }
.scr-dg .topbar{
    background:var(--navy-soft);
    border-bottom:2px solid var(--cyan);
    padding:15px 24px;
    display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap;
  }
.scr-dg .eyebrow{
    font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.08em;
    color:var(--cyan); text-transform:uppercase; margin-bottom:4px;
  }
.scr-dg h1{
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:21px;
    color:#FFFFFF; text-transform:uppercase; letter-spacing:0.01em;
  }
.scr-dg .subtitle{ margin-top:4px; color:var(--cyan-soft); font-size:12.5px; max-width:580px; line-height:1.5; }
.scr-dg .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.scr-dg .btn{
    border:1.5px solid var(--line); background:var(--card); color:var(--ink);
    padding:8px 14px; border-radius:8px; font-weight:600; font-size:12.5px;
    transition:transform .12s ease, border-color .12s ease;
  }
.scr-dg .btn:hover{ border-color:var(--cyan); transform:translateY(-1px); }
.scr-dg .btn:active{ transform:translateY(0) scale(.98); }
.scr-dg .btn.primary{ background:var(--cyan); color:#062230; border-color:var(--cyan); }
.scr-dg .btn.ghost{ background:transparent; color:#E7ECF1; border-color:#333944; }
.scr-dg .btn.ghost:hover{ border-color:var(--cyan); }
.scr-dg .btn.full{width:100%}
.scr-dg .btn.small{ padding:6px 10px; font-size:11.5px; }
.scr-dg .btn:disabled{ opacity:.4; cursor:not-allowed; transform:none; }
.scr-dg .badge{
    display:inline-flex; align-items:center; gap:6px; padding:6px 11px;
    border-radius:999px; background:var(--cyan-faint); color:#0E5C79;
    font-size:11.5px; font-weight:700; font-family:'IBM Plex Mono',monospace;
  }
.scr-dg .content{ padding:18px 24px 0; background:var(--paper); }
.scr-dg .layout{ display:grid; grid-template-columns:220px 1fr; gap:16px; align-items:start; }
.scr-dg .card{ background:var(--card); border:1px solid var(--line); border-radius:12px; padding:13px; }
.scr-dg .sidebar{display:flex;flex-direction:column;gap:13px}
.scr-dg .sidebar h3{ font-family:'Barlow Condensed',sans-serif; font-size:15px; font-weight:700; text-transform:uppercase; }
.scr-dg .legend{display:grid;gap:8px;font-size:12.5px;margin-top:8px}
.scr-dg .legend-row{display:flex;gap:9px;align-items:center}
.scr-dg .symbol{ flex-shrink:0; border:1.5px solid var(--ink); }
.scr-dg .symbol.action{width:26px;height:16px;border-radius:4px}
.scr-dg .symbol.initial{width:13px;height:13px;border-radius:50%;background:var(--ink);border:none}
.scr-dg .symbol.decision{width:14px;height:14px;background:var(--ink);clip-path:polygon(50% 0%,100% 50%,50% 100%,0% 50%);border:none}
.scr-dg .symbol.final{width:14px;height:14px;border-radius:50%;position:relative}
.scr-dg .symbol.final::after{content:"";position:absolute;inset:2.5px;border-radius:50%;background:var(--ink)}
.scr-dg .section-rule{border-top:1px solid var(--line);padding-top:11px}
.scr-dg .stack{display:grid;gap:7px}
.scr-dg .help{font-size:11.5px;color:var(--ink-muted);line-height:1.5}
.scr-dg .workspace-wrap{display:grid;gap:8px}
.scr-dg .workspace-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.scr-dg #dg_workspace{
    position:relative; min-height:560px; overflow:hidden;
    border:1px solid var(--line); border-radius:12px; background:var(--card);
    background-image:radial-gradient(var(--line) 1px, transparent 1px);
    background-size:28px 28px;
    touch-action:none;
  }
.scr-dg #dg_connectionLayer, .scr-dg #dg_nodeLayer{position:absolute;inset:0;width:100%;height:100%}
.scr-dg #dg_nodeLayer{pointer-events:none}
.scr-dg .builder-node{pointer-events:auto}
.scr-dg #dg_connectionLayer{pointer-events:none}
.scr-dg #dg_connectionLayer path.edge-line{pointer-events:stroke;cursor:pointer}
.scr-dg #dg_connectionLayer path.answer-line{pointer-events:none}
.scr-dg .builder-node{
    position:absolute; display:flex; align-items:center; justify-content:center;
    width:126px; min-height:42px; padding:7px 10px;
    border:1.5px solid var(--ink); border-radius:9px;
    background:var(--card); color:var(--ink); text-align:center;
    font-size:12.5px; font-weight:500; line-height:1.25;
    user-select:none; z-index:2;
    transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  }
.scr-dg .builder-node .body{cursor:grab}
.scr-dg .builder-node:hover{ transform:scale(1.03); box-shadow:0 3px 10px rgba(10,10,13,0.08); }
.scr-dg .builder-node.dragging{cursor:grabbing; box-shadow:0 6px 16px rgba(10,10,13,0.14);}
.scr-dg .builder-node.correct{ border-color:var(--success); background:var(--success-bg); }
.scr-dg .builder-node.wrong{ border-color:var(--danger); background:var(--danger-bg); }
.scr-dg .builder-node.initial, .scr-dg .builder-node.final{
    width:38px; min-height:38px; padding:0; border-radius:999px;
  }
.scr-dg .builder-node.initial{background:var(--ink);color:#fff;font-size:10.5px}
.scr-dg .builder-node.final::after{
    content:""; width:18px; height:18px; border-radius:999px; background:var(--ink);
  }
.scr-dg .builder-node.decision{
    width:64px; height:64px; min-height:64px; border:none; background:transparent; padding:0;
  }
.scr-dg .builder-node.merge{
    width:34px; height:34px; min-height:34px; border:none; background:transparent; padding:0;
  }
.scr-dg .diamond-shape{ position:absolute; inset:0; z-index:0; }
.scr-dg .diamond-shape polygon{ fill:var(--card); stroke:var(--ink); stroke-width:2; vector-effect:non-scaling-stroke; }
.scr-dg .builder-node.correct .diamond-shape polygon{ stroke:var(--success); fill:var(--success-bg); }
.scr-dg .builder-node.wrong .diamond-shape polygon{ stroke:var(--danger); fill:var(--danger-bg); }
.scr-dg .builder-node .body{ position:relative; z-index:1; }
.scr-dg .node-caption{
    position:absolute; top:100%; left:50%; transform:translateX(-50%);
    margin-top:5px; width:104px; text-align:center; pointer-events:none;
    font-size:12px; color:var(--ink); line-height:1.25; z-index:1;
  }
.scr-dg .status-icon{
    position:absolute; top:-9px; right:-9px; width:20px; height:20px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;
    color:#fff; z-index:3;
  }
.scr-dg .status-icon.correct{background:var(--success)}
.scr-dg .status-icon.wrong{background:var(--danger)}
.scr-dg .handle{
    position:absolute; width:9px; height:9px; border-radius:50%;
    background:var(--cyan); border:1.5px solid #fff; opacity:.28;
    cursor:crosshair; z-index:4; transition:opacity .12s ease, transform .12s ease;
  }
.scr-dg .builder-node:hover .handle{ opacity:.85; }
.scr-dg .handle:hover{ transform:scale(1.5); opacity:1; }
.scr-dg .handle.top{top:-5px;left:calc(50% - 4.5px)}
.scr-dg .handle.bottom{bottom:-5px;left:calc(50% - 4.5px)}
.scr-dg .handle.left{left:-5px;top:calc(50% - 4.5px)}
.scr-dg .handle.right{right:-5px;top:calc(50% - 4.5px)}
.scr-dg .edge-line{ fill:none; stroke:var(--ink); stroke-width:2.2; marker-end:url(#dg_builderArrow); }
.scr-dg .edge-line:hover{ stroke:var(--danger); stroke-width:3; }
.scr-dg .edge-line.removing{ stroke:var(--danger); }
.scr-dg .edge-label{ fill:#0E5C79; font-size:12.5px; font-weight:700; font-family:'IBM Plex Mono',monospace; }
.scr-dg .answer-line{ fill:none; stroke:var(--success); stroke-width:2; stroke-dasharray:2,5; }
.scr-dg .drag-line{ fill:none; stroke:var(--cyan); stroke-width:2.2; stroke-dasharray:2,5; }
.scr-dg .hint-text{ font-size:12.5px; color:var(--ink-muted); }
.scr-dg .helper-strip{ display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; font-size:12.5px; color:var(--ink-muted); }
.scr-dg .feedback{
    margin-top:12px; padding:11px 14px; border-radius:10px;
    background:var(--card); border:1px solid var(--line); border-left:3px solid var(--cyan);
    font-size:13px;
  }
.scr-dg .feedback.correct{ border-left-color:var(--success); background:var(--success-bg); }
.scr-dg .feedback.wrong{ border-left-color:var(--danger); background:var(--danger-bg); }
.scr-dg .feedback p+p{margin-top:5px;color:var(--ink-muted);font-size:12.5px;line-height:1.5}
.scr-dg .feedback-head{ display:flex; align-items:center; gap:8px; font-weight:700; font-size:13px; }
.scr-dg .metrics{
    margin:12px 0 20px; padding:10px 14px; display:flex; gap:22px; flex-wrap:wrap;
    background:var(--card); border:1px solid var(--line); border-radius:10px;
  }
.scr-dg .metric{ display:flex; align-items:baseline; gap:6px; }
.scr-dg .metric-label{ font-size:11px; color:var(--ink-muted); font-family:'IBM Plex Mono',monospace; text-transform:uppercase; }
.scr-dg .metric-value{ font-size:14px; font-weight:700; font-family:'Barlow Condensed',sans-serif; }
.scr-dg .scenario-chip{
    display:flex; align-items:center; gap:8px; font-size:12.5px; font-weight:600;
  }
.scr-dg .scenario-dot{
    width:20px; height:20px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono',monospace; font-size:10.5px; font-weight:700;
    border:1.5px solid var(--line); color:var(--ink-muted); background:var(--paper);
  }
.scr-dg .scenario-dot.pass{ background:var(--success); border-color:var(--success); color:#fff; }
.scr-dg .scenario-dot.fail{ background:var(--danger); border-color:var(--danger); color:#fff; }
.scr-dg .scenario-dot.active{ border-color:var(--cyan); color:var(--cyan); }
.scr-dg .scenario-desc{
    background:var(--card); border:1px solid var(--cyan); border-radius:12px;
    padding:16px 18px; margin-bottom:14px;
  }
.scr-dg .scenario-desc .k{ font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--cyan); text-transform:uppercase; margin-bottom:4px; }
.scr-dg .scenario-desc-inner{ display:flex; gap:18px; align-items:center; flex-wrap:wrap; }
.scr-dg .mini-board{ display:grid; grid-template-columns:repeat(3,30px); grid-template-rows:repeat(3,30px); gap:3px; flex-shrink:0; }
.scr-dg .mini-cell{
    width:30px; height:30px; border:1.5px solid var(--line); border-radius:5px;
    display:flex; align-items:center; justify-content:center;
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:16px;
    background:var(--paper); color:var(--ink);
  }
.scr-dg .mini-cell.x{ color:#0E5C79; }
.scr-dg .mini-cell.o{ color:#993C1D; }
.scr-dg .mini-cell.conflict{ border:2px dashed var(--danger); background:var(--danger-bg); }
.scr-dg .mini-cell.proposed{ border:2px dashed var(--cyan); background:var(--cyan-faint); opacity:0.8; }
.scr-dg .choice-row{ display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; }
.scr-dg .choice-btn{
    border:1.5px solid var(--cyan); background:var(--cyan-faint); color:#0E5C79;
    padding:9px 16px; border-radius:8px; font-weight:600; font-size:13px;
  }
.scr-dg .choice-btn:hover{ background:var(--cyan); color:#062230; }
.scr-dg .builder-node.traced{ border-color:var(--cyan); }
.scr-dg .builder-node.traced .diamond-shape polygon{ stroke:var(--cyan); }
.scr-dg .builder-node.current-step{ box-shadow:0 0 0 3px var(--cyan-soft); }
.scr-dg .edge-line.traced{ stroke:var(--cyan); stroke-width:3; }
.scr-dg dialog{ border:1px solid var(--line); border-radius:16px; padding:0; background:var(--card); color:var(--ink); }
.scr-dg dialog::backdrop{background:rgba(10,10,13,.55)}
.scr-dg .dialog-body{width:min(92vw,400px);padding:22px;display:grid;gap:16px}
.scr-dg label{display:grid;gap:6px;font-weight:600;font-size:13.5px}
.scr-dg input[type="password"]{
    width:100%; border:1.5px solid var(--line); border-radius:9px;
    padding:10px 12px; background:var(--paper); color:var(--ink);
  }
.scr-dg input[type="password"]:focus{ outline:2px solid var(--cyan); outline-offset:1px; border-color:var(--cyan); }
.scr-dg .error{color:var(--danger);font-size:13px;min-height:1.2em}
.scr-dg .dialog-actions{display:flex;justify-content:flex-end;gap:8px}
@media(max-width:900px){
.scr-dg .layout{grid-template-columns:1fr}.scr-dg #dg_workspace{min-height:600px}
}
@media(max-width:640px){
.scr-dg .topbar, .scr-dg .content{padding-left:16px;padding-right:16px}.scr-dg .metrics{flex-direction:column;gap:8px}
}

/* ============ shared shell: stepper nav ============ */
.sys611-topbar{
  background:#0A0A0D; border-bottom:2px solid #2BB4E0;
  padding:14px 24px; display:flex; align-items:center; gap:14px; flex-wrap:wrap;
}
.sys611-brand{
  font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.06em;
  color:#2BB4E0; text-transform:uppercase; flex-shrink:0; margin-right:6px;
}
#sys611-stepper{ display:flex; align-items:center; flex-wrap:wrap; gap:0; }
.sys611-step{
  display:inline-flex; align-items:center; gap:7px;
  background:transparent; border:none; color:#8B93A0;
  font-family:'IBM Plex Mono',monospace; font-size:11.5px; text-transform:uppercase;
  padding:6px 10px; border-radius:7px; cursor:pointer;
}
.sys611-step-num{
  display:inline-flex; align-items:center; justify-content:center;
  width:18px; height:18px; border-radius:50%; background:#23262C; color:#8B93A0;
  font-size:10px; font-weight:700;
}
.sys611-step.active{ color:#fff; }
.sys611-step.active .sys611-step-num{ background:#2BB4E0; color:#062230; }
.sys611-step.locked{ opacity:0.4; cursor:not-allowed; }
.sys611-step-sep{ color:#3A414C; font-size:13px; margin:0 2px; }
@media(max-width:760px){
  .sys611-topbar{ padding:12px 16px; }
  #sys611-stepper{ gap:2px; }
  .sys611-step{ padding:5px 7px; font-size:10.5px; }
}

