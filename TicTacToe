<script>
// ==================================================================
// SHARED SHELL: cross-module state, screen switching, stepper nav
// ==================================================================
window.SYS611 = { diagram: null, rule: null, boardFullDef: null, playerWonPassed: false };
window.SYS611_unlocked = { dg: true, vm: false, pw: false, bf: false, pl: false };

const SCREEN_META = {
  dg: { num: 1, label: 'Diagram' },
  vm: { num: 2, label: 'Valid Move?' },
  pw: { num: 3, label: 'Player Won?' },
  bf: { num: 4, label: 'Board Full?' },
  pl: { num: 5, label: 'Play' },
};

window.SYS611showScreen = function(id) {
  if (!window.SYS611_unlocked[id]) return;
  Object.keys(SCREEN_META).forEach(k => {
    const el = document.getElementById('screen-' + k);
    if (el) el.style.display = (k === id) ? 'block' : 'none';
  });
  renderStepper(id);
  window.scrollTo(0, 0);
  if (id === 'pl' && window.SYS611_playInit) window.SYS611_playInit();
};

window.SYS611unlock = function(id) {
  window.SYS611_unlocked[id] = true;
  renderStepper(currentScreenId());
};

function currentScreenId() {
  for (const k of Object.keys(SCREEN_META)) {
    const el = document.getElementById('screen-' + k);
    if (el && el.style.display !== 'none') return k;
  }
  return 'dg';
}

function renderStepper(activeId) {
  const stepper = document.getElementById('sys611-stepper');
  if (!stepper) return;
  stepper.innerHTML = Object.keys(SCREEN_META).map(k => {
    const meta = SCREEN_META[k];
    const unlocked = window.SYS611_unlocked[k];
    const isActive = k === activeId;
    const cls = ['sys611-step'];
    if (isActive) cls.push('active');
    if (!unlocked) cls.push('locked');
    return `<button class="${cls.join(' ')}" ${unlocked ? '' : 'disabled'} data-step="${k}">
      <span class="sys611-step-num">${meta.num}</span>${meta.label}
    </button>`;
  }).join('<span class="sys611-step-sep">&rsaquo;</span>');
  stepper.querySelectorAll('.sys611-step').forEach(btn => {
    btn.addEventListener('click', () => window.SYS611showScreen(btn.dataset.step));
  });
}

renderStepper('dg');


// ---- module: tictactoe_stress_test.html ----
(function(){

  const INSTRUCTOR_PASSWORD = 'stevens611';

  const workspace = document.getElementById('dg_workspace');
  const nodeLayer = document.getElementById('dg_nodeLayer');
  const svg = document.getElementById('dg_connectionLayer');
  const connectionLines = document.getElementById('dg_connectionLines');
  const answerLines = document.getElementById('dg_answerLines');
  const dragLineLayer = document.getElementById('dg_dragLineLayer');
  const connBadge = document.getElementById('dg_connBadge');
  const feedback = document.getElementById('dg_feedback');
  const modeText = document.getElementById('dg_modeText');
  const scenarioProgress = document.getElementById('dg_scenarioProgress');
  const exitTestButton = document.getElementById('dg_exitTestButton');
  const checkButton = document.getElementById('dg_checkButton');
  const passwordDialog = document.getElementById('dg_passwordDialog');
  const enteredPassword = document.getElementById('dg_enteredPassword');
  const passwordFeedback = document.getElementById('dg_passwordFeedback');

  const definitions = [
    { id: 'start', label: 'Start', type: 'initial' },
    { id: 'init', label: 'Initialize board', type: 'action' },
    { id: 'accept', label: 'Player input', type: 'action' },
    { id: 'validMove', label: 'Valid move?', type: 'decision' },
    { id: 'place', label: 'Place mark', type: 'action' },
    { id: 'checkWin', label: 'Player won?', type: 'decision' },
    { id: 'recordWinner', label: 'Record winner', type: 'action' },
    { id: 'checkDraw', label: 'Board full?', type: 'decision' },
    { id: 'recordDraw', label: 'Record draw', type: 'action' },
    { id: 'switchPlayer', label: 'Switch player', type: 'action' },
    { id: 'merge', label: '', type: 'merge' },
    { id: 'end', label: 'End', type: 'final' }
  ];

  const correctEdges = [
    ['start', 'init'], ['init', 'accept'], ['accept', 'validMove'],
    ['validMove', 'accept'], ['validMove', 'place'], ['place', 'checkWin'],
    ['checkWin', 'recordWinner'], ['checkWin', 'checkDraw'],
    ['checkDraw', 'recordDraw'], ['checkDraw', 'switchPlayer'],
    ['switchPlayer', 'accept'], ['recordWinner', 'merge'],
    ['recordDraw', 'merge'], ['merge', 'end']
  ];

  const edgeLabels = {
    'validMove>accept': '[no]', 'validMove>place': '[yes]',
    'checkWin>recordWinner': '[yes]', 'checkWin>checkDraw': '[no]',
    'checkDraw>recordDraw': '[yes]', 'checkDraw>switchPlayer': '[no]'
  };

  const scenarios = [
    {
      id: 'invalid',
      title: 'Occupied cell',
      desc: "A player tries to place a mark on a cell that's already taken.",
      board: ['', '', '', '', 'X', '', '', '', ''],
      target: 4, targetType: 'conflict', player: 'O',
      note: 'O attempts cell 5, which X already occupies.',
      check: trace => {
        const i = trace.indexOf('validMove');
        return i !== -1 && trace[i + 1] === 'accept' && !trace.includes('place');
      },
      failMsg: "This scenario needs a path from 'Valid move?' back to 'Player input' without ever touching 'Place mark'."
    },
    {
      id: 'win',
      title: 'Winning move',
      desc: 'A player makes the move that completes three in a row.',
      board: ['X', 'X', '', '', 'O', 'O', '', '', ''],
      target: 2, targetType: 'proposed', player: 'X',
      note: 'X attempts cell 3, completing the top row.',
      check: trace => trace.includes('recordWinner'),
      failMsg: "This scenario needs a path that reaches 'Record winner'."
    },
    {
      id: 'draw',
      title: 'Drawing move',
      desc: 'A player makes the move that fills the last empty cell without completing three in a row.',
      board: ['X', 'O', 'X', 'X', 'O', 'O', 'O', 'X', ''],
      target: 8, targetType: 'proposed', player: 'X',
      note: 'X attempts cell 9, the last open square, without completing a line.',
      check: trace => trace.includes('recordDraw'),
      failMsg: "This scenario needs a path that reaches 'Record draw'."
    },
    {
      id: 'continue',
      title: 'Ordinary move',
      desc: 'A player makes a move that neither wins nor fills the board.',
      board: ['X', '', '', '', 'O', '', '', '', ''],
      target: 1, targetType: 'proposed', player: 'X',
      note: 'X attempts cell 2. The game continues.',
      check: trace => trace.includes('switchPlayer'),
      failMsg: "This scenario needs a path that reaches 'Switch player'."
    }
  ];

  let connections = [];
  let showAnswer = false;
  let testMode = false;
  let scenarioIndex = 0;
  const scenarioResults = scenarios.map(() => null);
  let trace = [];
  let connectDrag = null;
  let bodyDrag = null;

  function randomPosition(index) {
    const width = Math.max(workspace.clientWidth, 560);
    const cols = 4;
    const col = index % cols;
    const row = Math.floor(index / cols);
    const spacing = Math.max(150, (width - 190) / cols);
    return { x: 18 + col * spacing + Math.random() * 18, y: 25 + row * 165 + Math.random() * 24 };
  }

  function shuffledSlots(n) {
    const slots = Array.from({ length: n }, (_, i) => i);
    for (let i = slots.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [slots[i], slots[j]] = [slots[j], slots[i]];
    }
    return slots;
  }

  function createNodes() {
    nodeLayer.innerHTML = '';
    const slots = shuffledSlots(definitions.length);
    definitions.forEach((definition, index) => {
      const node = document.createElement('div');
      node.className = `builder-node ${definition.type}`;
      node.dataset.id = definition.id;

      if (definition.type === 'decision' || definition.type === 'merge') {
        node.insertAdjacentHTML('beforeend',
          '<svg class="diamond-shape" viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="50,4 96,50 50,96 4,50"/></svg>');
      }
      if (definition.type === 'decision' && definition.label) {
        const caption = document.createElement('div');
        caption.className = 'node-caption';
        caption.textContent = definition.label;
        node.appendChild(caption);
      }

      const body = document.createElement('div');
      body.className = 'body';
      body.textContent = (definition.type === 'decision' || definition.type === 'merge') ? '' : definition.label;
      node.appendChild(body);

      ['top', 'right', 'bottom', 'left'].forEach(side => {
        const h = document.createElement('div');
        h.className = 'handle ' + side;
        h.dataset.side = side;
        h.addEventListener('pointerdown', startConnect);
        node.appendChild(h);
      });

      const position = randomPosition(slots[index]);
      node.style.left = `${position.x}px`;
      node.style.top = `${position.y}px`;

      node.addEventListener('pointerdown', startBodyDrag);
      nodeLayer.appendChild(node);
    });
    requestAnimationFrame(drawConnections);
  }

  function startBodyDrag(event) {
    if (testMode) return;
    const node = event.currentTarget.closest('.builder-node');
    const workspaceRect = workspace.getBoundingClientRect();
    const nodeRect = node.getBoundingClientRect();
    bodyDrag = {
      node,
      offsetX: event.clientX - nodeRect.left,
      offsetY: event.clientY - nodeRect.top,
      workspaceRect
    };
    node.classList.add('dragging');
    document.addEventListener('pointermove', moveBodyDrag);
    document.addEventListener('pointerup', endBodyDrag, { once: true });
  }
  function moveBodyDrag(event) {
    if (!bodyDrag) return;
    const node = bodyDrag.node;
    const maxX = workspace.clientWidth - node.offsetWidth;
    const maxY = workspace.clientHeight - node.offsetHeight;
    const x = Math.max(0, Math.min(maxX, event.clientX - bodyDrag.workspaceRect.left - bodyDrag.offsetX));
    const y = Math.max(0, Math.min(maxY, event.clientY - bodyDrag.workspaceRect.top - bodyDrag.offsetY));
    node.style.left = `${x}px`;
    node.style.top = `${y}px`;
    drawConnections();
  }
  function endBodyDrag() {
    if (bodyDrag) bodyDrag.node.classList.remove('dragging');
    bodyDrag = null;
    document.removeEventListener('pointermove', moveBodyDrag);
  }

  function startConnect(event) {
    event.stopPropagation();
    if (testMode) return;
    const node = event.currentTarget.closest('.builder-node');
    const workspaceRect = workspace.getBoundingClientRect();
    connectDrag = { sourceId: node.dataset.id, workspaceRect };
    document.addEventListener('pointermove', moveConnect);
    document.addEventListener('pointerup', endConnect, { once: true });
  }
  function moveConnect(event) {
    if (!connectDrag) return;
    const a = nodeCenter(connectDrag.sourceId);
    const x = event.clientX - connectDrag.workspaceRect.left;
    const y = event.clientY - connectDrag.workspaceRect.top;
    dragLineLayer.innerHTML = '';
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('class', 'drag-line');
    path.setAttribute('marker-end', 'url(#dg_dragArrow)');
    path.setAttribute('d', `M ${a.x} ${a.y} L ${x} ${y}`);
    dragLineLayer.appendChild(path);
  }
  function endConnect(event) {
    dragLineLayer.innerHTML = '';
    document.removeEventListener('pointermove', moveConnect);
    if (!connectDrag) return;
    const target = document.elementFromPoint(event.clientX, event.clientY);
    const targetNode = target ? target.closest('.builder-node') : null;
    if (targetNode && targetNode.dataset.id !== connectDrag.sourceId) {
      const targetId = targetNode.dataset.id;
      const duplicate = connections.some(e => e[0] === connectDrag.sourceId && e[1] === targetId);
      if (!duplicate) {
        connections.push([connectDrag.sourceId, targetId]);
        updateBadge();
        drawConnections(true);
      }
    }
    connectDrag = null;
  }

  function nodeCenter(id) {
    const node = document.querySelector(`[data-id="${id}"]`);
    const workspaceRect = workspace.getBoundingClientRect();
    const rect = node.getBoundingClientRect();
    return { x: rect.left - workspaceRect.left + rect.width / 2, y: rect.top - workspaceRect.top + rect.height / 2 };
  }

  function pathFor(a, b, controlPoint) {
    if (controlPoint) {
      return `M ${a.x} ${a.y} Q ${controlPoint.x} ${controlPoint.y} ${b.x} ${b.y}`;
    }
    const midY = a.y + (b.y - a.y) / 2;
    return `M ${a.x} ${a.y} C ${a.x} ${midY}, ${b.x} ${midY}, ${b.x} ${b.y}`;
  }

  function bendControlPoint(source, target, edgeList) {
    const hasReverse = edgeList.some(c => c[0] === target && c[1] === source);
    if (!hasReverse) return null;
    const lo = source < target ? source : target;
    const hi = source < target ? target : source;
    const pa = nodeCenter(lo), pb = nodeCenter(hi);
    const mx = (pa.x + pb.x) / 2, my = (pa.y + pb.y) / 2;
    const dx = pb.x - pa.x, dy = pb.y - pa.y;
    const len = Math.hypot(dx, dy) || 1;
    const nx = -dy / len, ny = dx / len;
    const sign = source === lo ? 1 : -1;
    const bendAmt = 26 * sign;
    return { x: mx + nx * bendAmt, y: my + ny * bendAmt };
  }

  function drawConnections(animateLast) {
    svg.setAttribute('viewBox', `0 0 ${workspace.clientWidth} ${workspace.clientHeight}`);
    connectionLines.innerHTML = '';

    connections.forEach(([source, target], idx) => {
      const a = nodeCenter(source);
      const b = nodeCenter(target);
      const cp = bendControlPoint(source, target, connections);
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('class', 'edge-line');
      path.setAttribute('data-source', source);
      path.setAttribute('data-target', target);
      path.setAttribute('d', pathFor(a, b, cp));
      path.addEventListener('click', () => removeConnection(idx));
      connectionLines.appendChild(path);

      if (animateLast && idx === connections.length - 1) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = len;
        path.style.strokeDashoffset = len;
        path.getBoundingClientRect();
        path.style.transition = 'stroke-dashoffset .35s ease';
        requestAnimationFrame(() => { path.style.strokeDashoffset = 0; });
      }

      const labelText = edgeLabels[`${source}>${target}`];
      if (labelText) {
        const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        label.setAttribute('class', 'edge-label');
        const lx = cp ? cp.x : (a.x + b.x) / 2;
        const ly = cp ? cp.y : (a.y + b.y) / 2;
        label.setAttribute('x', String(lx + 6));
        label.setAttribute('y', String(ly - 7));
        label.textContent = labelText;
        connectionLines.appendChild(label);
      }
    });

    if (showAnswer) drawAnswerOverlay();
  }

  function drawAnswerOverlay() {
    answerLines.innerHTML = '';
    correctEdges.forEach(([source, target]) => {
      const a = nodeCenter(source);
      const b = nodeCenter(target);
      const cp = bendControlPoint(source, target, correctEdges);
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('class', 'answer-line');
      path.setAttribute('marker-end', 'url(#dg_answerArrow)');
      path.setAttribute('d', pathFor(a, b, cp));
      answerLines.appendChild(path);
    });
  }

  function removeConnection(idx) {
    if (testMode) return;
    const paths = connectionLines.querySelectorAll('path.edge-line');
    if (paths[idx]) paths[idx].classList.add('removing');
    setTimeout(() => {
      connections.splice(idx, 1);
      updateBadge();
      drawConnections();
    }, 130);
  }

  function updateBadge() {
    connBadge.textContent = `${connections.length} connection${connections.length === 1 ? '' : 's'}`;
  }

  function edgeKey(e) { return `${e[0]}>${e[1]}`; }
  function findNodeLabel(id) {
    const d = definitions.find(item => item.id === id);
    return d && d.label ? d.label : 'merge point';
  }

  function clearStatusIcons() {
    document.querySelectorAll('.status-icon').forEach(n => n.remove());
    document.querySelectorAll('.builder-node').forEach(n => n.classList.remove('correct', 'wrong'));
  }

  function currentNode() { return trace[trace.length - 1]; }

  function renderMiniBoard(s) {
    const cells = s.board.map((val, i) => {
      let cls = 'mini-cell';
      let content = val;
      if (val === 'X') cls += ' x';
      if (val === 'O') cls += ' o';
      if (i === s.target) {
        cls += ' ' + s.targetType;
        if (s.targetType === 'proposed') content = s.player;
      }
      return `<div class="${cls}">${content}</div>`;
    }).join('');
    return `<div class="mini-board">${cells}</div>`;
  }

  function scenarioDescHTML(s, index) {
    return `<div class="scenario-desc"><div class="k">Scenario ${index + 1} of ${scenarios.length}</div>
      <div class="scenario-desc-inner">
        ${renderMiniBoard(s)}
        <div><strong>${s.desc}</strong><p style="font-size:12.5px;color:var(--ink-muted);margin:4px 0 0;">${s.note}</p></div>
      </div>
    </div>`;
  }

  function clearTraceHighlights() {
    document.querySelectorAll('.builder-node').forEach(n => n.classList.remove('traced', 'current-step'));
    document.querySelectorAll('.edge-line').forEach(p => p.classList.remove('traced'));
  }

  function highlightTrace() {
    document.querySelectorAll('.builder-node').forEach(n => n.classList.remove('current-step'));
    trace.forEach(id => {
      const n = document.querySelector(`.builder-node[data-id="${id}"]`);
      if (n) n.classList.add('traced');
    });
    const last = document.querySelector(`.builder-node[data-id="${currentNode()}"]`);
    if (last) last.classList.add('current-step');
    for (let i = 0; i < trace.length - 1; i++) {
      const p = connectionLines.querySelector(`path[data-source="${trace[i]}"][data-target="${trace[i+1]}"]`);
      if (p) p.classList.add('traced');
    }
  }

  function renderScenarioProgress() {
    scenarioProgress.innerHTML = scenarios.map((s, i) => {
      const result = scenarioResults[i];
      const cls = result === true ? 'pass' : result === false ? 'fail' : (testMode && i === scenarioIndex) ? 'active' : '';
      const mark = result === true ? '&check;' : result === false ? '&times;' : (i + 1);
      return `<div class="scenario-chip"><span class="scenario-dot ${cls}">${mark}</span>${s.title}</div>`;
    }).join('');
  }

  function findOrphans() {
    const touched = new Set();
    connections.forEach(([s, t]) => { touched.add(s); touched.add(t); });
    return definitions.filter(d => d.id !== 'start' && !touched.has(d.id));
  }

  function runPreflightCheck() {
    const orphans = findOrphans();
    if (orphans.length === 0) { startStressTest(); return; }
    const names = orphans.map(o => `"${o.label || 'the merge point'}"`).join(', ');
    feedback.className = 'feedback wrong';
    feedback.innerHTML = `<div class="feedback-head">Before we test this</div><p>${names} ${orphans.length === 1 ? "isn't" : "aren't"} connected to anything yet. Every scenario needs a way to reach every block it might use. Connect ${orphans.length === 1 ? 'it' : 'them'} first, or test anyway to see what breaks.</p><div class="choice-row"><button class="choice-btn" id="dg_testAnywayBtn">Test anyway</button></div>`;
    document.getElementById('dg_testAnywayBtn').addEventListener('click', startStressTest);
  }

  function findSatisfyingPath(scenario, maxDepth) {
    maxDepth = maxDepth || 15;
    const path = ['start'];
    function dfs(depth) {
      if (scenario.check(path)) return true;
      if (depth >= maxDepth) return false;
      const last = path[path.length - 1];
      const outgoing = connections.filter(c => c[0] === last).map(c => c[1]);
      for (const next of outgoing) {
        path.push(next);
        if (dfs(depth + 1)) return true;
        path.pop();
      }
      return false;
    }
    return dfs(0) ? path.slice() : null;
  }

  function startStressTest() {
    testMode = true;
    scenarioIndex = 0;
    scenarioResults.fill(null);
    clearStatusIcons();
    modeText.textContent = 'Stress test';
    checkButton.style.display = 'none';
    exitTestButton.style.display = 'block';
    renderScenarioProgress();
    runScenario(0);
  }

  function runScenario(index) {
    scenarioIndex = index;
    clearTraceHighlights();
    renderScenarioProgress();
    const s = scenarios[index];
    feedback.className = 'feedback';
    feedback.innerHTML = `${scenarioDescHTML(s, index)}<p>Checking every path your diagram allows&hellip;</p>`;

    setTimeout(() => {
      const found = findSatisfyingPath(s);
      if (found) {
        animatePath(found, () => reportResult(index, true, found));
      } else {
        reportResult(index, false, null);
      }
    }, 180);
  }

  function animatePath(fullPath, done) {
    trace = [fullPath[0]];
    highlightTrace();
    let i = 1;
    function step() {
      if (i >= fullPath.length) { done(); return; }
      trace.push(fullPath[i]);
      highlightTrace();
      i++;
      setTimeout(step, 150);
    }
    setTimeout(step, 150);
  }

  function reportResult(index, passed, path) {
    scenarioResults[index] = passed;
    renderScenarioProgress();
    const s = scenarios[index];

    if (passed) {
      feedback.className = 'feedback correct';
      feedback.innerHTML = `${scenarioDescHTML(s, index)}<div class="feedback-head">Passed</div><p>"${s.title}" holds up.</p>`;
    } else {
      feedback.className = 'feedback wrong';
      feedback.innerHTML = `${scenarioDescHTML(s, index)}<div class="feedback-head">Failed</div><p>${s.failMsg}</p>`;
    }

    const isLast = index === scenarios.length - 1;
    setTimeout(() => {
      if (isLast) { showFinalSummary(); } else { runScenario(index + 1); }
    }, passed ? 450 : 900);
  }

  function showFinalSummary() {
    const allPassed = scenarioResults.every(r => r === true);
    if (allPassed) {
      feedback.className = 'feedback correct';
      window.SYS611.diagram = connections.slice();
      window.SYS611unlock('vm');
      feedback.innerHTML = '<div class="feedback-head">Every stress test passed</div><p>Your process survives every scenario we threw at it. This model is production ready.</p><p style="margin-top:10px;font-size:12.5px;color:var(--ink-muted);">Next: your diagram treats "Valid move?", "Player won?", and "Board full?" as black boxes. The next three activities ask you to define the actual logic behind each one.</p><button class="choice-btn" style="margin-top:10px;" id="dg_nextBtn">Start with Valid Move? &rsaquo;</button>';
      document.getElementById('dg_nextBtn').addEventListener('click', () => window.SYS611showScreen('vm'));
      document.querySelectorAll('.builder-node').forEach(n => n.classList.add('correct'));
      playSuccessAnimation();
      return;
    }
    const failed = scenarios.filter((s, i) => scenarioResults[i] === false);
    const items = failed.map(s => `<li style="margin-bottom:6px;"><strong>${s.title}:</strong> ${s.failMsg}</li>`).join('');
    feedback.className = 'feedback wrong';
    feedback.innerHTML = `<div class="feedback-head">${failed.length} of ${scenarios.length} scenarios broke it</div><ul style="margin:8px 0 0;padding-left:18px;font-size:13px;">${items}</ul><div class="choice-row"><button class="choice-btn" id="dg_retryAllBtn">Fix diagram and retest</button></div>`;
    document.getElementById('dg_retryAllBtn').addEventListener('click', exitTestMode);
    clearTraceHighlights();
  }

  function exitTestMode() {
    testMode = false;
    scenarioResults.fill(null);
    clearTraceHighlights();
    modeText.textContent = 'Editing';
    checkButton.style.display = 'block';
    exitTestButton.style.display = 'none';
    scenarioProgress.innerHTML = '';
    feedback.className = 'feedback';
    feedback.innerHTML = '<div class="feedback-head"><span>Your task</span></div><p>Connect the blocks so every kind of tic-tac-toe turn has somewhere to go, then run the stress test to find out if it actually holds up.</p>';
    clearStatusIcons();
  }

  function playSuccessAnimation() {
    const adjacency = {};
    connections.forEach(([s, t]) => { (adjacency[s] = adjacency[s] || []).push(t); });
    const order = [];
    const visited = new Set();
    const queue = ['start'];
    while (queue.length) {
      const id = queue.shift();
      (adjacency[id] || []).forEach(next => {
        const key = id + '>' + next;
        if (!visited.has(key)) { visited.add(key); order.push([id, next]); queue.push(next); }
      });
    }
    let i = 0;
    function step() {
      if (i >= order.length) return;
      const [s, t] = order[i];
      const a = nodeCenter(s), b = nodeCenter(t);
      const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      dot.setAttribute('r', '6');
      dot.setAttribute('fill', 'var(--cyan)');
      dot.setAttribute('cx', a.x);
      dot.setAttribute('cy', a.y);
      dot.style.transition = 'cx .4s ease, cy .4s ease';
      dragLineLayer.appendChild(dot);
      requestAnimationFrame(() => { dot.setAttribute('cx', b.x); dot.setAttribute('cy', b.y); });
      setTimeout(() => dot.remove(), 450);
      i += 1;
      setTimeout(step, 220);
    }
    step();
  }

  function resetAll() {
    connections = [];
    showAnswer = false;
    testMode = false;
    scenarioResults.fill(null);
    trace = [];
    answerLines.innerHTML = '';
    modeText.textContent = 'Editing';
    checkButton.style.display = 'block';
    exitTestButton.style.display = 'none';
    scenarioProgress.innerHTML = '';
    document.getElementById('dg_answerButton').textContent = 'Instructor answer';
    clearStatusIcons();
    clearTraceHighlights();
    createNodes();
    updateBadge();
    feedback.className = 'feedback';
    feedback.innerHTML = '<div class="feedback-head"><span>Your task</span></div><p>Connect the blocks so every kind of tic-tac-toe turn has somewhere to go, then run the stress test to find out if it actually holds up.</p>';
  }

  checkButton.addEventListener('click', runPreflightCheck);
  exitTestButton.addEventListener('click', exitTestMode);
  document.getElementById('dg_resetButton').addEventListener('click', resetAll);
  renderScenarioProgress();

  document.getElementById('dg_answerButton').addEventListener('click', () => {
    if (showAnswer) {
      showAnswer = false;
      answerLines.innerHTML = '';
      document.getElementById('dg_answerButton').textContent = 'Instructor answer';
      return;
    }
    enteredPassword.value = '';
    passwordFeedback.textContent = '';
    passwordDialog.showModal();
  });
  document.getElementById('dg_cancelPasswordButton').addEventListener('click', () => passwordDialog.close());
  document.getElementById('dg_submitPasswordButton').addEventListener('click', () => {
    if (enteredPassword.value !== INSTRUCTOR_PASSWORD) {
      passwordFeedback.textContent = 'Incorrect password.';
      return;
    }
    passwordDialog.close();
    showAnswer = true;
    document.getElementById('dg_answerButton').textContent = 'Hide answer';
    drawConnections();
  });
  enteredPassword.addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('dg_submitPasswordButton').click();
  });

  window.addEventListener('resize', () => drawConnections());

  createNodes();
  updateBadge();

})();

// ---- module: valid_move_quest.html ----
(function(){

  const primitives = [
    { id: 'cellEmpty', label: 'The target cell is empty' },
    { id: 'gamePlaying', label: 'The game is still in progress' },
    { id: 'playersTurn', label: "It matches the current player's turn" },
    { id: 'fewerThan9', label: 'Fewer than 9 marks are on the board' },
    { id: 'validIndex', label: 'The cell index is between 1 and 9' },
    { id: 'firstMove', label: 'This is the first move of the game' },
  ];

  const evaluators = {
    cellEmpty: tc => tc.board[tc.target] === '',
    gamePlaying: tc => tc.status === 'playing',
    playersTurn: () => true,
    fewerThan9: tc => tc.board.filter(c => c !== '').length < 9,
    validIndex: tc => tc.target >= 0 && tc.target <= 8,
    firstMove: tc => tc.board.filter(c => c !== '').length === 0,
  };

  const CORRECT_SET = ['cellEmpty', 'gamePlaying'];

  const testCases = [
    { board: ['','','','','','','','',''], target: 4, status: 'playing', desc: "The very first move of the game." },
    { board: ['X','','','','','','','',''], target: 4, status: 'playing', desc: "The second move, right after X went first." },
    { board: ['X','O','','','','','','',''], target: 0, status: 'playing', desc: "An attempt to play a cell X already occupies." },
    { board: ['X','X','X','O','O','','','',''], target: 5, status: 'won-X', desc: "X already completed the top row. Someone tries cell 6 anyway." },
    { board: ['X','O','X','O','','','','',''], target: 4, status: 'playing', desc: "A routine move, midgame." },
    { board: ['X','O','X','O','X','O','X','O',''], target: 8, status: 'playing', desc: "The last open cell, with the game still undecided." },
    { board: ['X','O','X','X','O','O','O','X','X'], target: 8, status: 'draw', desc: "An attempt to play after the board already ended in a draw." },
    { board: ['X','O','','X','O','','','',''], target: 5, status: 'playing', desc: "Another routine move, well into the game." },
  ];

  function expectedValid(tc) {
    return tc.board[tc.target] === '' && tc.status === 'playing';
  }

  let ruleConditions = [];
  let ruleOperators = [];

  const palette = document.getElementById('vm_palette');
  const ruleArea = document.getElementById('vm_ruleArea');
  const results = document.getElementById('vm_results');

  function renderPalette() {
    palette.innerHTML = '';
    primitives.forEach(p => {
      const btn = document.createElement('button');
      btn.className = 'prim-chip';
      btn.disabled = ruleConditions.includes(p.id);
      btn.innerHTML = `<span>${p.label}</span><span class="plus">${btn.disabled ? '&check;' : '+'}</span>`;
      btn.addEventListener('click', () => {
        ruleConditions.push(p.id);
        if (ruleConditions.length > 1) ruleOperators.push('AND');
        renderAll();
      });
      palette.appendChild(btn);
    });
  }

  function renderRule() {
    if (ruleConditions.length === 0) {
      ruleArea.innerHTML = '<p class="rule-empty">Click conditions on the left to build your rule.</p>';
      return;
    }
    ruleArea.innerHTML = '';
    ruleConditions.forEach((id, i) => {
      if (i > 0) {
        const opBtn = document.createElement('button');
        opBtn.className = 'op-toggle';
        opBtn.textContent = ruleOperators[i - 1];
        opBtn.addEventListener('click', () => {
          ruleOperators[i - 1] = ruleOperators[i - 1] === 'AND' ? 'OR' : 'AND';
          renderRule();
        });
        const wrap = document.createElement('div');
        wrap.style.textAlign = 'center';
        wrap.appendChild(opBtn);
        ruleArea.appendChild(wrap);
      }
      const label = primitives.find(p => p.id === id).label;
      const chip = document.createElement('div');
      chip.className = 'rule-chip';
      chip.innerHTML = `<span>${label}</span>`;
      const rm = document.createElement('button');
      rm.textContent = '\u00d7';
      rm.addEventListener('click', () => {
        const idx = ruleConditions.indexOf(id);
        ruleConditions.splice(idx, 1);
        ruleOperators.splice(Math.max(0, idx - 1), 1);
        renderAll();
      });
      chip.appendChild(rm);
      ruleArea.appendChild(chip);
    });
  }

  function renderAll() {
    renderPalette();
    renderRule();
  }

  function evaluateRule(tc) {
    if (ruleConditions.length === 0) return null;
    let result = evaluators[ruleConditions[0]](tc);
    for (let i = 1; i < ruleConditions.length; i++) {
      const v = evaluators[ruleConditions[i]](tc);
      result = ruleOperators[i - 1] === 'AND' ? (result && v) : (result || v);
    }
    return result;
  }

  function renderMiniBoard(tc) {
    const cells = tc.board.map((val, i) => {
      let cls = 'mini-cell';
      if (val === 'X') cls += ' x';
      if (val === 'O') cls += ' o';
      if (i === tc.target) cls += ' target';
      return `<div class="${cls}">${val}</div>`;
    }).join('');
    return `<div class="mini-board">${cells}</div>`;
  }

  document.getElementById('vm_runTestsBtn').addEventListener('click', () => {
    if (ruleConditions.length === 0) {
      results.innerHTML = '<div class="summary-banner fail"><div class="summary-head">Add at least one condition first</div></div>';
      return;
    }

    const testResults = testCases.map(tc => {
      const expected = expectedValid(tc);
      const actual = evaluateRule(tc);
      return { tc, expected, actual, pass: actual === expected };
    });
    const passCount = testResults.filter(r => r.pass).length;
    const allPass = passCount === testCases.length;

    const studentSet = new Set(ruleConditions);
    const missing = CORRECT_SET.filter(id => !studentSet.has(id));
    const extra = ruleConditions.filter(id => !CORRECT_SET.includes(id));
    const usesOR = ruleOperators.includes('OR');

    let structuralNote = '';
    if (missing.length || extra.length || usesOR) {
      const parts = [];
      if (missing.length) parts.push(`missing <b>${missing.map(id => primitives.find(p=>p.id===id).label).join(', ')}</b>`);
      if (extra.length) parts.push(`includes conditions that aren't actually necessary (<b>${extra.map(id => primitives.find(p=>p.id===id).label).join(', ')}</b>)`);
      if (usesOR) parts.push(`uses <b>OR</b> somewhere, when both conditions need to hold at once`);
      structuralNote = `<p class="structural-note">Structurally, your rule ${parts.join('; ')}.</p>`;
    } else {
      structuralNote = `<p class="structural-note">Structurally, this matches what a valid move actually depends on: both conditions, joined with AND.</p>`;
    }

    if (allPass) {
      window.SYS611.rule = { conditions: ruleConditions.slice(), operators: ruleOperators.slice() };
      window.SYS611unlock('pw');
    }

    const bannerClass = allPass ? 'pass' : 'fail';
    const bannerHead = allPass ? `All ${testCases.length} tests passed` : `${passCount} of ${testCases.length} tests passed`;
    const bannerSub = allPass
      ? 'Your rule correctly separates valid moves from invalid ones across every situation we tried.'
      : "Some of these situations broke your rule. Check the cards below marked as failed, then adjust your rule and test again.";
    const nextLink = allPass ? '<button class="btn primary" id="vm_nextBtn" style="width:100%;margin-top:10px;">Continue to Player Won? &rsaquo;</button>' : '';

    const cardsHtml = testResults.map(r => `
      <div class="test-card ${r.pass ? 'pass' : 'fail'}">
        ${renderMiniBoard(r.tc)}
        <div>
          <div class="test-desc">${r.tc.desc}</div>
          <div class="test-verdict ${r.pass ? 'pass' : 'fail'}">
            Expected ${r.expected ? 'valid' : 'invalid'}, your rule said ${r.actual ? 'valid' : 'invalid'}
          </div>
        </div>
      </div>
    `).join('');

    results.innerHTML = `
      <div class="summary-banner ${bannerClass}">
        <div class="summary-head">${bannerHead}</div>
        <p>${bannerSub}</p>
        ${structuralNote}
        ${nextLink}
      </div>
      <div class="test-grid">${cardsHtml}</div>
    `;
    if (allPass) document.getElementById('vm_nextBtn').addEventListener('click', () => window.SYS611showScreen('pw'));
  });

  renderAll();

})();

// ---- module: player_won_quest.html ----
(function(){

  const LINES = [
    { id: 'row0', name: 'Top row', cells: [0,1,2] },
    { id: 'row1', name: 'Middle row', cells: [3,4,5] },
    { id: 'row2', name: 'Bottom row', cells: [6,7,8] },
    { id: 'col0', name: 'Left column', cells: [0,3,6] },
    { id: 'col1', name: 'Middle column', cells: [1,4,7] },
    { id: 'col2', name: 'Right column', cells: [2,5,8] },
    { id: 'diag0', name: 'Diagonal \u2198', cells: [0,4,8] },
    { id: 'diag1', name: 'Diagonal \u2199', cells: [2,4,6] },
  ];

  function findWinningLine(board) {
    for (const line of LINES) {
      const [a, b, c] = line.cells;
      if (board[a] && board[a] === board[b] && board[b] === board[c]) return line;
    }
    return null;
  }

  const testCases = [
    { board: ['X','X','X','O','O','','','',''], desc: "Early in the game." },
    { board: ['X','O','','','O','','X','O','X'], desc: "Midgame position." },
    { board: ['X','O','O','','X','','','','X'], desc: "A game with several moves played." },
    { board: ['','O','X','O','X','','X','','O'], desc: "Both players have been active." },
    { board: ['X','O','X','O','X','O','O','X','O'], desc: "The board just filled up." },
    { board: ['X','','X','O','X','','O','O','O'], desc: "Late in the game." },
    { board: ['O','O','X','X','O','X','O','','X'], desc: "A tightly contested board." },
    { board: ['X','','','','O','','','',''], desc: "Only two moves have been played." },
  ];

  testCases.forEach(tc => { tc.expected = findWinningLine(tc.board); });

  const answers = testCases.map(() => ({ call: null, line: null }));

  const grid = document.getElementById('pw_grid');
  const summary = document.getElementById('pw_summary');

  function renderMiniBoard(tc, litLine) {
    const litCells = litLine ? new Set(litLine.cells) : new Set();
    const cells = tc.board.map((val, i) => {
      let cls = 'mini-cell';
      if (val === 'X') cls += ' x';
      if (val === 'O') cls += ' o';
      if (litCells.has(i)) cls += ' lit';
      return `<div class="${cls}">${val}</div>`;
    }).join('');
    return `<div class="mini-board">${cells}</div>`;
  }

  function renderGrid() {
    grid.innerHTML = '';
    testCases.forEach((tc, idx) => {
      const card = document.createElement('div');
      card.className = 'test-card';
      card.innerHTML = `
        <div class="tc-top">
          ${renderMiniBoard(tc)}
          <div class="test-desc">${tc.desc}</div>
        </div>
        <div class="call-row">
          <button class="call-btn" data-call="win">Win</button>
          <button class="call-btn" data-call="nowin">No win</button>
        </div>
        <div class="line-picker" style="display:none;"></div>
        <div class="result-slot"></div>
      `;
      const callBtns = card.querySelectorAll('.call-btn');
      const linePicker = card.querySelector('.line-picker');

      callBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          callBtns.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          answers[idx].call = btn.dataset.call;
          if (btn.dataset.call === 'win') {
            linePicker.style.display = 'flex';
            linePicker.innerHTML = LINES.map(l => `<button class="line-btn" data-line="${l.id}">${l.name}</button>`).join('');
            linePicker.querySelectorAll('.line-btn').forEach(lb => {
              lb.addEventListener('click', () => {
                linePicker.querySelectorAll('.line-btn').forEach(b => b.classList.remove('selected'));
                lb.classList.add('selected');
                answers[idx].line = lb.dataset.line;
              });
            });
          } else {
            linePicker.style.display = 'none';
            answers[idx].line = null;
          }
        });
      });

      grid.appendChild(card);
    });
  }

  document.getElementById('pw_checkBtn').addEventListener('click', () => {
    let correctCount = 0;
    const cards = grid.querySelectorAll('.test-card');

    testCases.forEach((tc, idx) => {
      const ans = answers[idx];
      const expectedWin = tc.expected !== null;
      const callCorrect = ans.call !== null && (ans.call === 'win') === expectedWin;
      const lineCorrect = !expectedWin || ans.line === tc.expected.id;
      const pass = callCorrect && lineCorrect;
      if (pass) correctCount++;

      const card = cards[idx];
      card.classList.remove('pass', 'fail');
      card.classList.add(pass ? 'pass' : 'fail');

      const boardWrap = card.querySelector('.mini-board');
      boardWrap.outerHTML = renderMiniBoard(tc, pass && expectedWin ? tc.expected : null);

      let verdictText;
      if (ans.call === null) {
        verdictText = 'No answer given';
      } else if (expectedWin) {
        verdictText = `Actually ${tc.expected.name}, you said ${ans.call === 'win' ? (ans.line ? LINES.find(l=>l.id===ans.line).name : 'win, no line chosen') : 'no win'}`;
      } else {
        verdictText = `Actually no win, you said ${ans.call === 'win' ? 'win' : 'no win'}`;
      }
      const slot = card.querySelector('.result-slot');
      slot.innerHTML = `<div class="verdict ${pass ? 'pass' : 'fail'}">${verdictText}</div>`;
    });

    const allPass = correctCount === testCases.length;
    if (allPass) { window.SYS611.playerWonPassed = true; window.SYS611unlock('bf'); }
    const nextLink = allPass ? '<button class="btn primary" id="pw_nextBtn" style="width:100%;margin-top:10px;">Continue to Board Full? &rsaquo;</button>' : '';
    summary.innerHTML = `
      <div class="summary-banner ${allPass ? 'pass' : 'fail'}">
        <div class="summary-head">${correctCount} of ${testCases.length} correct</div>
        <p>${allPass ? "You're correctly recognizing every winning pattern, across rows, columns, and both diagonals." : "Check the cards outlined in red. Some wins were missed, misattributed to the wrong line, or called on boards that don't actually have one."}</p>
        ${nextLink}
      </div>
    `;
    if (allPass) document.getElementById('pw_nextBtn').addEventListener('click', () => window.SYS611showScreen('bf'));
  });

  renderGrid();

})();

// ---- module: board_full_quest.html ----
(function(){

  const options = [
    { id: 'allOccupied', label: 'All 9 cells are occupied' },
    { id: 'noWinner', label: 'There is no winner yet' },
    { id: 'centerTaken', label: 'The center cell is occupied' },
    { id: 'fourEach', label: 'Both players have played at least 4 moves each' },
  ];

  const evaluators = {
    allOccupied: tc => tc.board.every(c => c !== ''),
    noWinner: tc => tc.status !== 'won-X' && tc.status !== 'won-O',
    centerTaken: tc => tc.board[4] !== '',
    fourEach: tc => {
      const x = tc.board.filter(c => c === 'X').length;
      const o = tc.board.filter(c => c === 'O').length;
      return x >= 4 && o >= 4;
    },
  };

  const testCases = [
    { board: ['','','','','','','','',''], status: 'playing', desc: "The opening position." },
    { board: ['X','O','X','','O','','','',''], status: 'playing', desc: "Partway through the game." },
    { board: ['X','O','X','O','X','O','X','O',''], status: 'playing', desc: "One cell left to play." },
    { board: ['X','O','X','O','O','X','O','X','O'], status: 'draw', desc: "A full board that ended without a winner." },
    { board: ['X','X','X','O','O','X','O','X','O'], status: 'won-X', desc: "A full board where X already won earlier." },
    { board: ['','','','','X','','','',''], status: 'playing', desc: "Only the center has been played." },
  ];

  function expectedFull(tc) { return tc.board.every(c => c !== ''); }

  let selected = null;

  const optionsEl = document.getElementById('bf_options');
  const resultsEl = document.getElementById('bf_results');

  function renderOptions() {
    optionsEl.innerHTML = '';
    options.forEach(o => {
      const btn = document.createElement('button');
      btn.className = 'option' + (selected === o.id ? ' selected' : '');
      btn.textContent = o.label;
      btn.addEventListener('click', () => { selected = o.id; renderOptions(); });
      optionsEl.appendChild(btn);
    });
  }

  function renderMiniBoard(tc) {
    const cells = tc.board.map(val => {
      let cls = 'mini-cell';
      if (val === 'X') cls += ' x';
      if (val === 'O') cls += ' o';
      return `<div class="${cls}">${val}</div>`;
    }).join('');
    return `<div class="mini-board">${cells}</div>`;
  }

  document.getElementById('bf_runBtn').addEventListener('click', () => {
    if (!selected) {
      resultsEl.innerHTML = '<div class="summary-banner fail"><div class="summary-head">Pick a definition first</div></div>';
      return;
    }
    const evaluator = evaluators[selected];
    const testResults = testCases.map(tc => {
      const expected = expectedFull(tc);
      const actual = evaluator(tc);
      return { tc, expected, actual, pass: actual === expected };
    });
    const passCount = testResults.filter(r => r.pass).length;
    const allPass = passCount === testCases.length;

    const cardsHtml = testResults.map(r => `
      <div class="test-card ${r.pass ? 'pass' : 'fail'}">
        ${renderMiniBoard(r.tc)}
        <div>
          <div class="test-desc">${r.tc.desc}</div>
          <div class="test-verdict ${r.pass ? 'pass' : 'fail'}">
            Expected ${r.expected ? 'full' : 'not full'}, your rule said ${r.actual ? 'full' : 'not full'}
          </div>
        </div>
      </div>
    `).join('');

    if (allPass) { window.SYS611.boardFullDef = selected; window.SYS611unlock('pl'); }
    const nextLink = allPass ? '<button class="btn primary" id="bf_nextBtn" style="width:100%;margin-top:10px;">Play the game you built &rsaquo;</button>' : '';

    resultsEl.innerHTML = `
      <div class="summary-banner ${allPass ? 'pass' : 'fail'}">
        <div class="summary-head">${allPass ? 'All 6 tests passed' : passCount + ' of 6 tests passed'}</div>
        <p>${allPass ? 'This definition correctly identifies a full board, regardless of whether anyone won.' : "This definition breaks on at least one situation below. A full board check only needs to know one thing: is every cell occupied."}</p>
        ${nextLink}
      </div>
      <div class="test-grid">${cardsHtml}</div>
    `;
    if (allPass) document.getElementById('bf_nextBtn').addEventListener('click', () => window.SYS611showScreen('pl'));
  });

  renderOptions();

})();

// ---- module: tictactoe_play.html ----
(function(){

  // ---------------------------------------------------------------- load student artifacts
  window.SYS611_playInit = function() {
  const layout = document.getElementById('pl_layout');

  const missing = [];
  if (!window.SYS611.diagram) missing.push({ label: 'Your activity diagram', screen: 'dg' });
  if (!window.SYS611.rule) missing.push({ label: 'Your "Valid move?" rule', screen: 'vm' });
  if (!window.SYS611.boardFullDef) missing.push({ label: 'Your "Board full?" definition', screen: 'bf' });

  if (missing.length) {
    layout.innerHTML = `
      <div class="missing-card">
        <h2>Not quite ready yet</h2>
        <p style="font-size:13.5px;color:var(--ink-muted);">This game is built from three earlier pieces, and ${missing.length === 1 ? "one of them hasn't" : "some of them haven't"} been completed yet:</p>
        <ul>${missing.map(m => `<li><a href="#" data-goto="${m.screen}">${m.label}</a></li>`).join('')}</ul>
      </div>
    `;
    layout.querySelectorAll('a[data-goto]').forEach(a => {
      a.addEventListener('click', (e) => { e.preventDefault(); window.SYS611showScreen(a.dataset.goto); });
    });
  } else {
    runGame();
  }

  function runGame() {
    const connections = window.SYS611.diagram.slice();
    const rule = window.SYS611.rule;
    const boardFullDefId = window.SYS611.boardFullDef;

    // ---------------------------------------------------------------- evaluators (mirrors the quests)
    const validMoveEvaluators = {
      cellEmpty: ctx => ctx.board[ctx.target] === '',
      gamePlaying: ctx => ctx.status === 'playing',
      playersTurn: () => true,
      fewerThan9: ctx => ctx.board.filter(c => c !== '').length < 9,
      validIndex: ctx => ctx.target >= 0 && ctx.target <= 8,
      firstMove: ctx => ctx.board.filter(c => c !== '').length === 0,
    };
    const boardFullEvaluators = {
      allOccupied: ctx => ctx.board.every(c => c !== ''),
      noWinner: ctx => ctx.status !== 'won-X' && ctx.status !== 'won-O',
      centerTaken: ctx => ctx.board[4] !== '',
      fourEach: ctx => {
        const x = ctx.board.filter(c => c === 'X').length;
        const o = ctx.board.filter(c => c === 'O').length;
        return x >= 4 && o >= 4;
      },
    };

    function evalValidMove(ctx) {
      let result = validMoveEvaluators[rule.conditions[0]](ctx);
      for (let i = 1; i < rule.conditions.length; i++) {
        const v = validMoveEvaluators[rule.conditions[i]](ctx);
        result = rule.operators[i - 1] === 'AND' ? (result && v) : (result || v);
      }
      return result;
    }
    function evalBoardFull(ctx) {
      return boardFullEvaluators[boardFullDefId](ctx);
    }

    const WIN_LINES = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    function hasWin(board, player) {
      return WIN_LINES.some(line => line.every(i => board[i] === player));
    }

    // ---------------------------------------------------------------- decision branch inference
    // For each fixed decision block, the outgoing edge to THIS target is the true branch;
    // everything else from that node is the false branch. Inferred from node identity,
    // not from student-authored labels.
    const TRUE_TARGET = { validMove: 'place', checkWin: 'recordWinner', checkDraw: 'recordDraw' };

    function outgoingFrom(nodeId) {
      return connections.filter(c => c[0] === nodeId).map(c => c[1]);
    }

    let board, currentPlayer, status, stuckAt;

    function chooseNext(nodeId, ctx) {
      const opts = outgoingFrom(nodeId);
      if (opts.length === 0) return null;
      if (nodeId === 'validMove') {
        const desired = evalValidMove(ctx) ? 'place' : 'accept';
        return opts.includes(desired) ? desired : null;
      }
      if (nodeId === 'checkWin') {
        const desired = hasWin(ctx.board, ctx.currentPlayer) ? 'recordWinner' : 'checkDraw';
        return opts.includes(desired) ? desired : null;
      }
      if (nodeId === 'checkDraw') {
        const desired = evalBoardFull(ctx) ? 'recordDraw' : 'switchPlayer';
        return opts.includes(desired) ? desired : null;
      }
      return opts[0];
    }

    function walk(fromNode, target) {
      let current = fromNode;
      let steps = 0;
      while (steps < 20) {
        steps++;
        const ctx = { board, target, status, currentPlayer };
        const next = chooseNext(current, ctx);
        if (!next) { stuckAt = current; return; }
        current = next;
        if (current === 'place') board[target] = currentPlayer;
        if (current === 'recordWinner') status = 'won-' + currentPlayer;
        if (current === 'recordDraw') status = 'draw';
        if (current === 'switchPlayer') currentPlayer = currentPlayer === 'X' ? 'O' : 'X';
        if (current === 'accept' || current === 'end') return;
      }
      stuckAt = current;
    }

    function initGame() {
      board = Array(9).fill('');
      currentPlayer = 'X';
      status = 'playing';
      stuckAt = null;
      walk('start', null);
      render();
    }

    function handleClick(index) {
      if (status !== 'playing' || stuckAt) return;
      walk('accept', index);
      render();
    }

    // ---------------------------------------------------------------- rendering
    layout.innerHTML = `
      <div class="card">
        <div class="status" id="pl_statusText"></div>
        <div class="board" id="pl_board"></div>
        <button class="btn primary" id="pl_newGameBtn">New game</button>
        <div id="pl_stuckSlot"></div>
        <div class="credits">
          Built from <b>${connections.length}</b> connections in your diagram, your <b>${rule.conditions.length}-condition</b> valid-move rule, and your board-full definition.
        </div>
      </div>
    `;

    const boardEl = document.getElementById('pl_board');
    const statusEl = document.getElementById('pl_statusText');
    const stuckSlot = document.getElementById('pl_stuckSlot');

    function render() {
      boardEl.innerHTML = '';
      board.forEach((val, i) => {
        const btn = document.createElement('button');
        btn.className = 'cell' + (val === 'X' ? ' x' : val === 'O' ? ' o' : '');
        btn.textContent = val;
        btn.disabled = status !== 'playing' || !!stuckAt;
        btn.addEventListener('click', () => handleClick(i));
        boardEl.appendChild(btn);
      });

      if (stuckAt) {
        statusEl.textContent = 'Stuck';
        statusEl.className = 'status stuck';
        stuckSlot.innerHTML = `<div class="stuck-note">Your diagram has no way forward from "${stuckAt}" for this situation. That means it passed the stress test's scenarios, but this particular sequence of moves exposes a gap. Go back and add the missing connection, then return here.</div>`;
      } else if (status === 'playing') {
        statusEl.textContent = currentPlayer + "'s turn";
        statusEl.className = 'status';
        stuckSlot.innerHTML = '';
      } else if (status === 'draw') {
        statusEl.textContent = 'Draw';
        statusEl.className = 'status';
        stuckSlot.innerHTML = '';
      } else {
        statusEl.textContent = status.replace('won-', '') + ' wins';
        statusEl.className = 'status win';
        stuckSlot.innerHTML = '';
      }
    }

    document.getElementById('pl_newGameBtn').addEventListener('click', initGame);
    initGame();
  }
  };

})();
</script>
