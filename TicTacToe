              </marker>
              <marker id="dg_dragArrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L0,6 L9,3 z" fill="var(--cyan)"></path>
              </marker>
            </defs>
            <g id="dg_answerLines"></g>
            <g id="dg_connectionLines"></g>
