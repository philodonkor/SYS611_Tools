      <p id="dg_passwordFeedback" class="error" aria-live="polite"></p>
      <div class="dialog-actions">
        <button id="dg_cancelPasswordButton" class="btn" type="button">Cancel</button>
        <button id="dg_submitPasswordButton" class="btn primary" type="button">Reveal answer</button>
