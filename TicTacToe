  <dialog id="dg_passwordDialog">
    <div class="dialog-body">
      <div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:19px;font-weight:700;">Instructor access</h3>
        <p class="help" style="margin-top:6px">Enter the instructor password to overlay a reference solution on your diagram. Yours doesn't have to match it exactly, it just has to pass the same stress tests.</p>
      </div>
      <label>
        Password
        <input id="dg_enteredPassword" type="password" autocomplete="current-password">
