      <div class="workspace-wrap">
        <div class="workspace-head">
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:17px;font-weight:700;text-transform:uppercase;">Student workspace</h3>
          <span class="hint-text" id="dg_modeText">Editing</span>
        </div>

        <div id="dg_workspace" aria-label="Activity diagram construction canvas">
          <svg id="dg_connectionLayer" aria-hidden="true">
            <defs>
              <marker id="dg_builderArrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L0,6 L9,3 z" fill="var(--ink)"></path>
              </marker>
              <marker id="dg_answerArrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
